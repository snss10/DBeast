# =============================================================================
# DBeast PostgreSQL MCP Server - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Use EITHER DATABASE_URL OR individual DB_* variables (not both).
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE CONNECTION (Option 1: Connection URL - Recommended)
# -----------------------------------------------------------------------------
# Full PostgreSQL connection string. If set, individual DB_* vars are ignored.
# Format: postgresql://user:password@host:port/database?sslmode=prefer
DATABASE_URL=

# -----------------------------------------------------------------------------
# DATABASE CONNECTION (Option 2: Individual Parameters)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=postgres
# Options: disable, allow, prefer, require, verify-ca, verify-full
DB_SSLMODE=prefer

# -----------------------------------------------------------------------------
# AWS SECRETS MANAGER (Option 3: Load credentials from AWS)
# -----------------------------------------------------------------------------
# If set, credentials will be fetched from AWS Secrets Manager.
# Requires boto3 and AWS credentials configured.
AWS_SECRET_NAME=
AWS_REGION=us-west-1

# =============================================================================
# CONNECTION POOL SETTINGS
# =============================================================================
# Minimum number of connections to maintain in the pool (1-100)
DBEAST_POOL_MIN_SIZE=1
# Maximum number of connections allowed in the pool (1-100)
DBEAST_POOL_MAX_SIZE=5
# SQL command timeout in seconds (1-3600, default: 300 / 5 min for DB-wide analysis)
DBEAST_COMMAND_TIMEOUT=300
# Timeout for acquiring connection from pool in seconds (1-600, default: 300 / 5 min)
DBEAST_POOL_CONNECTION_TIMEOUT=300

# =============================================================================
# QUERY SETTINGS
# =============================================================================
# Default query timeout in seconds (1-3600, default: 300 / 5 min for complex queries)
DBEAST_QUERY_TIMEOUT=300
# Default maximum rows returned by queries (1-100000)
DBEAST_DEFAULT_ROW_LIMIT=100

# =============================================================================
# SSL/TLS SETTINGS
# =============================================================================
# Verify SSL certificates (set to false only for development with self-signed certs)
DBEAST_SSL_VERIFY=true

# =============================================================================
# LOGGING
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
DBEAST_LOG_LEVEL=INFO
# Use JSON format for logs (recommended for production/log aggregation)
DBEAST_LOG_JSON=false

# =============================================================================
# CONNECTION RETRY
# =============================================================================
# Maximum connection retry attempts (0-10)
DBEAST_CONNECTION_MAX_RETRIES=5
# Delay between connection retries in seconds (0.1-60.0)
DBEAST_CONNECTION_RETRY_DELAY=1.0

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable Docker PostgreSQL container discovery (disable in production)
DBEAST_ENABLE_DOCKER_DISCOVERY=true

# =============================================================================
# RISK THRESHOLDS FOR IMPACT ANALYSIS
# =============================================================================
# Row count threshold for mass UPDATE warning
DBEAST_MASS_UPDATE_ROWS=1000
# Row count threshold for mass DELETE warning
DBEAST_MASS_DELETE_ROWS=100
# Percentage of table affected to trigger dangerous warning (1-100)
DBEAST_DANGEROUS_PERCENT=50
# Percentage of table affected to trigger critical warning (1-100)
DBEAST_CRITICAL_PERCENT=90

# =============================================================================
# CACHING
# =============================================================================
# Schema cache TTL in seconds (0 to disable caching)
DBEAST_SCHEMA_CACHE_TTL=60

# =============================================================================
# AUDIT LOGGING
# =============================================================================
# Enable MCP request/response audit logging (true/false)
DBEAST_AUDIT_ENABLED=true
# Directory for audit log files (relative to project root)
DBEAST_AUDIT_DIR=logs/mcp_audit
# Maximum response size in audit logs (truncates if larger)
DBEAST_AUDIT_MAX_RESPONSE_SIZE=10000
